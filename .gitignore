# System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment Variables (Secrets)
.env
.env.local
.env.*.local
# Keep .env.example
!.env.example

# Certificates & Keys (Critical Security)
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx

# ProxyGateway Runtime Data
ProxyGateway/nginx/ssl/*
!ProxyGateway/nginx/ssl/.gitkeep
ProxyGateway/nginx/html/*
!ProxyGateway/nginx/html/.gitkeep

# acme 多账号数据目录 (每账号一个子目录)
ProxyGateway/acme/*
!ProxyGateway/acme/.gitkeep

# DNS 账号凭证 (每账号一份, 严禁提交; *.env.example 模板保留)
ProxyGateway/accounts/*.env

# Temporary & Backups
*.log
*.bak
*.tmp

# Docker
docker-compose.override.yml
