# ==========================================
# ProxyGateway 通用配置 (所有 acme 账号共享)
# DNS 账号凭证已拆分至 accounts/<账号名>.env
# setup.sh 会自动生成同名文件; 手动复制的请务必改掉下面的示例邮箱
# ==========================================

# 时区: 注入网关所有容器, 决定证书续期与镜像自动更新在何时执行
TZ=Asia/Shanghai

# 证书注册邮箱 (Let's Encrypt 会发续期提醒)
# [必须修改] 保留示例值不会导致签发失败, 但证书到期提醒邮件将无人接收
#           (setup.sh 与 doctor.sh 都会就此给出提示)
ACME_EMAIL=your_email@example.com

# 默认证书颁发机构 (letsencrypt / letsencrypt_test / zerossl)
ACME_SERVER=letsencrypt

# [Note] 本文件由容器创建时注入 (env_file), 修改后必须执行
#        cd ProxyGateway && docker compose up -d 才会生效。
