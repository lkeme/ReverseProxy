# 环境变量示例
# 这些变量会被 docker-compose.yml 加载，并注入到容器中
#
# 使用前: cp .env.example .env
# (docker-compose.yml 通过 env_file 加载本文件，缺了它 compose 会直接报错)

# 应用运行环境
APP_ENV=production

# 应用在容器内实际监听的端口
# [Note] 示例变量: 只有应用本身读取 APP_PORT 时才生效, 不会改变实际监听端口
# [Important] 应用实际监听的端口必须与 app.conf 中 proxy_pass 的端口一致, 否则网关会返回 502
#             (Dockerfile 的 EXPOSE 只是说明性信息, 同理不会改变监听端口)
APP_PORT=80

# 数据库连接 (如果需要)
# DB_HOST=postgres
# DB_USER=admin
# DB_PASS=secret
